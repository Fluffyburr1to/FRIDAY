{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!**/dist", "!**/coverage", "!**/node_modules", "!**/.turbo", "!**/*.gguf"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "json": {
    "formatter": { "enabled": true },
    "parser": { "allowComments": true }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",

      "suspicious": {
        "preset": "recommended",
        "noExplicitAny": "error",
        "noDoubleEquals": "error",
        "noEmptyBlockStatements": "error",
        "useAwait": "error",
        "noVar": "error",

        // ALL console methods are banned, not just log. console.error also
        // bypasses the logger's redaction layer, and a leaked credential in
        // stderr is exactly as bad as one in stdout.
        // Use @friday/telemetry. See docs/01-bible/22-logging-standards.md
        "noConsole": "error"
      },

      "correctness": {
        "preset": "recommended",
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "useExhaustiveDependencies": "error"
      },

      "complexity": {
        "preset": "recommended",
        "noForEach": "off",
        "noExcessiveCognitiveComplexity": {
          "level": "warn",
          "options": { "maxAllowedComplexity": 15 }
        }
      },

      "style": {
        "preset": "recommended",
        "useNamingConvention": "off",
        "noNonNullAssertion": "error",
        "useConst": "error",
        "useNodejsImportProtocol": "error",

        // Chapter 14: connectors are the ONLY components that talk to the
        // outside world. The egress allowlist enforces WHERE a connector may
        // go; this enforces that nothing else goes anywhere at all.
        //
        // A global needs no import, so the dependency-cruiser rules alongside
        // this one cannot see it — `fetch` is reachable from any file in the
        // repository with no declaration anywhere. Banned here and allowed
        // back only in connector-sdk, which is where the allowlist lives.
        "noRestrictedGlobals": {
          "level": "error",
          "options": {
            "deniedGlobals": {
              "fetch": "Only @friday/connector-sdk may reach the network. Use the guarded fetch it hands the connector, so the manifest's egress allowlist applies.",
              "XMLHttpRequest": "Only @friday/connector-sdk may reach the network. See Chapter 14.",
              "WebSocket": "Only @friday/connector-sdk may reach the network. See Chapter 14.",
              "EventSource": "Only @friday/connector-sdk may reach the network. See Chapter 14."
            }
          }
        }
      },

      "nursery": {
        // Every promise awaited or explicitly voided. A floating promise
        // swallows its error silently — which in a system that must record
        // everything before acting is a correctness problem, not a style one.
        "noFloatingPromises": "error"
      },

      // `biome migrate` set these three to "none", which would silently
      // disable them. Accessibility in particular is not optional: Chapter 06
      // commits to WCAG 2.2 AA, and a founding document about respect and
      // service cannot ship an unusable interface.
      "security": { "preset": "recommended" },
      "a11y": { "preset": "recommended" },
      "performance": { "preset": "recommended" }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/tests/**"],
      "linter": {
        "rules": {
          "suspicious": { "noExplicitAny": "off" },

          // Tests are not shipped, and an integration test has to be able to
          // call FRIDAY's own loopback server — which ADR-0030 is explicit is
          // the owner's machine rather than the outside world.
          //
          // ★ This is why the lint rule is the second line rather than the
          // first. What actually stops a connector reaching an undeclared
          // host is the runtime allowlist in connector-sdk, which applies to
          // every caller including a test. The rule below only keeps shipped
          // source from acquiring network access by accident.
          "style": { "noNonNullAssertion": "off", "noRestrictedGlobals": "off" }
        }
      }
    },
    {
      // Fixtures that deliberately attempt what FRIDAY forbids, so a test can
      // assert the refusal actually happens. A fixture that could not reach
      // for the network could not prove the sandbox stops it — the ban would
      // be asserted against nothing. Not FRIDAY's running code, same as the
      // build-tooling exemption below.
      "includes": ["**/test/fixtures/**"],
      "linter": {
        "rules": {
          "style": { "noRestrictedGlobals": "off" }
        }
      }
    },
    {
      // The one package allowed to reach the network — it is where the
      // allowlist is enforced, so it necessarily holds the thing being
      // guarded. Scoped to this package and nothing else.
      "includes": ["packages/connector-sdk/**"],
      "linter": {
        "rules": {
          "style": { "noRestrictedGlobals": "off" }
        }
      }
    },
    {
      // Build and maintenance scripts are terminal tools. Printing IS their
      // job, and they never touch user data — so the logger requirement,
      // which exists to prevent accidental leaks in the running system, does
      // not apply. This exception is scoped to tools/ and nothing else.
      "includes": ["tools/scripts/**", "tools/**/*.mjs"],
      "linter": {
        "rules": {
          "suspicious": { "noConsole": "off" }
        }
      }
    }
  ]
}
