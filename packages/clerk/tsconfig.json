{
  // Paths live here rather than in @friday/tsconfig, because TypeScript
  // resolves relative paths against the file they were written in.
  "extends": "@friday/tsconfig/library.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  // The three things the clerk composes, and nothing else. `storage` is
  // deliberately absent: the clerk reaches the database only through the
  // Guardian's store ports and the kernel's bus, which is what keeps it a seam
  // rather than a second way into the log.
  "references": [{ "path": "../contracts" }, { "path": "../guardian" }, { "path": "../kernel" }],
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "coverage", "test"]
}
