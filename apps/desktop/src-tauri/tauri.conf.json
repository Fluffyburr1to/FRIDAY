{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FRIDAY",
  "version": "0.1.0",
  "identifier": "com.friday.desktop",
  "build": {
    "frontendDist": "http://127.0.0.1:7420"
  },
  "app": {
    "windows": [
      {
        "title": "FRIDAY",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:7420; connect-src 'self' http://127.0.0.1:7420; style-src 'self' 'unsafe-inline' http://127.0.0.1:7420; img-src 'self' data: http://127.0.0.1:7420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
