{
  "name": "@friday/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "friday-core \u2014 the kernel service and the API the dashboard reads.",
  "license": "UNLICENSED",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist coverage .turbo",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@friday/audit": "workspace:*",
    "@friday/chief-of-staff": "workspace:*",
    "@friday/clerk": "workspace:*",
    "@friday/config": "workspace:*",
    "@friday/contracts": "workspace:*",
    "@friday/diagnostics": "workspace:*",
    "@friday/guardian": "workspace:*",
    "@friday/kernel": "workspace:*",
    "@friday/model-router": "workspace:*",
    "@friday/operations": "workspace:*",
    "@friday/storage": "workspace:*",
    "@trpc/server": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@friday/audit": "workspace:*",
    "@friday/tsconfig": "workspace:*",
    "@friday/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "vitest": "catalog:"
  }
}
