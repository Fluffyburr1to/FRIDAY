# ─────────────────────────────────────────────────────────────────────────────
# FRIDAY — environment variables
#
# Copy to .env for local development. .env is git-ignored.
#
# ★ NO SECRET VALUES BELONG IN THIS FILE OR IN .env ★
#   Credentials live in the macOS Keychain. Configuration holds Keychain
#   *references*, never the secrets themselves.
#   See docs/01-bible/18-security-model.md
#
# All variables are read only by packages/config, validated with Zod at
# startup. Invalid configuration sends FRIDAY into Safe Mode with a clear
# message rather than a mysterious failure three hours later.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment ──────────────────────────────────────────────────────────────
# development | staging | production
FRIDAY_ENV=development

# ── Principal ────────────────────────────────────────────────────────────────
# Whose data this instance holds. Every row and every event carries it, and
# every query filters by it — from the first migration, so multi-user isolation
# has been exercised for years before a second person exists.
# See docs/01-bible/09-database-design.md
FRIDAY_PRINCIPAL_ID=usr_owner

# ── Storage ──────────────────────────────────────────────────────────────────
# Three separate files, deliberately: different durability requirements,
# different write patterns, different growth rates.
# See docs/01-bible/09-database-design.md
FRIDAY_DATA_DIR=~/Library/Application Support/FRIDAY
FRIDAY_DB_PATH=${FRIDAY_DATA_DIR}/friday.db
FRIDAY_EVENTS_DB_PATH=${FRIDAY_DATA_DIR}/events.db
FRIDAY_CACHE_DB_PATH=${FRIDAY_DATA_DIR}/cache.db

# ── Server ───────────────────────────────────────────────────────────────────
FRIDAY_HOST=127.0.0.1
FRIDAY_PORT=7420

# ── Logging ──────────────────────────────────────────────────────────────────
# fatal | error | warn | info | debug | trace
FRIDAY_LOG_LEVEL=debug
FRIDAY_LOG_DIR=~/Library/Logs/FRIDAY

# ── Model Router ─────────────────────────────────────────────────────────────
# ★ API keys are NOT set here. They live in the Keychain; these are the
#   service names used to look them up.
FRIDAY_KEYCHAIN_SERVICE=com.friday.credentials
FRIDAY_ANTHROPIC_KEY_REF=anthropic-api-key
FRIDAY_OPENAI_KEY_REF=openai-api-key

# ── Field encryption ─────────────────────────────────────────────────────────
# The AES-256-GCM key that encrypts `private` columns in friday.db. Also a
# Keychain reference, not a key. `secret` data is never in the database at all.
# See docs/01-bible/09-database-design.md
FRIDAY_FIELD_KEY_REF=field-encryption-key

# Local model runtime — used for anything classified `private` or above.
# The router FAILS CLOSED: a sensitive request is refused rather than
# downgraded to a cloud provider when this is unavailable.
FRIDAY_OLLAMA_URL=http://127.0.0.1:11434

# ── Budgets (cents) ──────────────────────────────────────────────────────────
# Every level fails closed. Exhausted means stop — never "continue and bill it."
# A runaway overnight agent loop is the most plausible route to a surprise bill
# an order of magnitude over budget. See docs/01-bible/35-performance-goals.md
FRIDAY_BUDGET_PER_AGENT_CENTS=15
FRIDAY_BUDGET_PER_PLAN_CENTS=50
FRIDAY_BUDGET_PER_DAY_CENTS=800
FRIDAY_BUDGET_PER_MONTH_CENTS=15000

# ── Backups ──────────────────────────────────────────────────────────────────
# Encrypted BEFORE leaving the machine. The provider stores a blob it cannot
# read. Key lives in the Keychain AND on the printed recovery card.
FRIDAY_BACKUP_ENABLED=false
FRIDAY_BACKUP_BUCKET=
FRIDAY_BACKUP_KEY_REF=backup-encryption-key

# ── Telemetry ────────────────────────────────────────────────────────────────
# Localhost only. Nothing is exported off this machine, ever.
# See docs/01-bible/29-monitoring-observability.md
FRIDAY_OTEL_ENABLED=false
FRIDAY_OTEL_ENDPOINT=http://127.0.0.1:4318
