{
  "name": "friday",
  "version": "0.0.0",
  "private": true,
  "description": "A Personal Artificial Intelligence Operating System",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "friday": "node apps/cli/dist/index.js",
    "hud": "node tools/scripts/hud.mjs",
    "check": "pnpm run check:format && pnpm run check:lint && pnpm run check:types && pnpm run check:boundaries && pnpm run check:docs && pnpm run check:workflows && pnpm run test",
    "check:format": "biome format .",
    "check:lint": "biome lint .",
    "check:types": "node tools/scripts/check-types.mjs",
    "check:boundaries": "node tools/scripts/check-boundaries.mjs",
    "check:docs": "node tools/scripts/check-docs.mjs",
    "check:workflows": "node tools/scripts/check-workflows.mjs",
    "check:secrets": "gitleaks detect --no-banner --redact || echo 'gitleaks not installed \u2014 CI enforces this'",
    "fix": "biome check --write .",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "test": "turbo run build && turbo run test && vitest run",
    "test:unit": "turbo run test -- --project '*:unit'",
    "test:integration": "turbo run test -- --project '*:integration'",
    "test:coverage": "turbo run test:coverage",
    "build": "turbo run build",
    "setup": "bash tools/scripts/install-git-hooks.sh",
    "clean": "turbo run clean && rm -rf node_modules",
    "test:cross": "turbo run build && vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@changesets/cli": "^2.29.7",
    "@friday/agent-runtime": "workspace:*",
    "@friday/audit": "workspace:*",
    "@friday/chief-of-staff": "workspace:*",
    "@friday/cli": "workspace:*",
    "@friday/config": "workspace:*",
    "@friday/connector-open-meteo": "workspace:*",
    "@friday/connector-sdk": "workspace:*",
    "@friday/contracts": "workspace:*",
    "@friday/core": "workspace:*",
    "@friday/guardian": "workspace:*",
    "@friday/kernel": "workspace:*",
    "@friday/model-router": "workspace:*",
    "@friday/storage": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dependency-cruiser": "^18.1.1",
    "js-yaml": "^5.3.0",
    "turbo": "^2.5.0",
    "typescript": "^5.6.3",
    "vitest": "catalog:"
  }
}
